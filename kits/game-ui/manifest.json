  },
  "gameart": {
    "source": "https://kenney.nl/assets",
    "offline": true,
    "packs": [
      {
        "pack": "kenney-ui-pack",
        "version": "2026-10-03-catalog",
        "license": "kits/game-ui/LICENSE-kenney.txt",
        "slots": [
          { "slot": "hud-backdrop", "mode": "inline" },
          { "slot": "avatar-base", "mode": "inline" }
        ]
      }
    ]
  },
  "engines": {
    "forge": "kits/game-ui/hud.html + menu.html drop into forge HUD slice (link tokens.css + buttons.css)",
    "engine2040": "kits/game-ui/menu.html skin for engine2040 menu (same two <link> imports)"
  }
}
